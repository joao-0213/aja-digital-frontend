# Configure before building the static frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3002/api/v1
# API process: export these variables in the shell; no automatic .env loading.
API_PORT=3002
API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
# Origin used for operator outbox links; must belong to API_ALLOWED_ORIGINS.
API_FRONTEND_ORIGIN=http://127.0.0.1:3000
# Local HTTP uses false; HTTPS origins always require Secure cookies.
API_COOKIE_SECURE=false
