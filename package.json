{
  "name": "aja-digital-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:export": "node scripts/check-static-export.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm run check:architecture && npm test && npm run build && npm run check:export",
    "api": "node --experimental-strip-types server/index.mjs",
    "api:reset": "node server/reset.mjs",
    "api:outbox": "node --experimental-strip-types server/outbox.mjs",
    "dev:full": "npm run dev",
    "dev:mock": "node scripts/dev-mock.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "json-server": "0.17.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
